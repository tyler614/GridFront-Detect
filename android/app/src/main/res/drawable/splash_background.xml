<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Match the boot animation so Android-to-app handoff does not flash white. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#000000"/>
        </shape>
    </item>
    <!-- GridFront logo centered -->
    <item
        android:gravity="center"
        android:width="80dp"
        android:height="80dp"
        android:drawable="@drawable/gridfront_logo"/>
</layer-list>
