<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">#FFF8F8F8</item>
        <item name="android:navigationBarColor">#FFF8F8F8</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- The WebView shows a green teardrop "cursor handle" by default
             that doesn't match our theme. We use our own in-page keyboard
             so users never need to drag the caret manually — hiding the
             handle keeps text inputs clean. -->
        <item name="android:textSelectHandle">@android:color/transparent</item>
        <item name="android:textSelectHandleLeft">@android:color/transparent</item>
        <item name="android:textSelectHandleRight">@android:color/transparent</item>
    </style>

    <style name="PowerMenuTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="PowerMenuButton" parent="Widget.AppCompat.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/power_menu_btn</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">normal</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PowerMenuButtonSecondary" parent="PowerMenuButton">
        <item name="android:background">@drawable/power_menu_btn_secondary</item>
        <item name="android:textColor">#9CA3AF</item>
    </style>
</resources>
