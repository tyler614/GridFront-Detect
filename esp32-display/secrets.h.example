// Copy this file to secrets.h and fill in your WiFi + server values.
// secrets.h is gitignored so credentials don't leak.
#pragma once

#define WIFI_SSID   "your-ssid-here"
#define WIFI_PASS   "your-password-here"

// The laptop running the Detect Flask app on the same LAN.
// This was your WiFi IPv4 at scaffold time — update if DHCP reassigns.
#define SERVER_HOST "192.168.68.64"
#define SERVER_PORT 5555

// UDP port the ESP listens on for detection packets.
#define UDP_PORT    5556
